{
    "download_path": "./downloads/",
    "download_quality": "hifi",
    "album_folder_format": "{artist} - {album}{explicit} ({year}) [{quality}]",
    "track_filename_format": "{track_number}. {title}",
    "quality_format": "{bit_depth}B-{sample_rate}kHz",
